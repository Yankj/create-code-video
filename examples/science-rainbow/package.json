{
  "name": "create-code-video-science-rainbow",
  "version": "3.3.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "gen-audio": "python3 gen_audio.py",
    "render": "remotion render src/index.ts RainbowV2 out/rainbow-remotion-v2.mp4 --codec h264 --crf 20",
    "render:v1": "remotion render src/index.ts Rainbow out/rainbow-remotion.mp4 --codec h264 --crf 23"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/media": "4.0.539",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
